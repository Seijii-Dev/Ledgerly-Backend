# Supabase project settings. Find these in Supabase Dashboard -> Project Settings -> API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# For Vercel, the same names can be configured as SUPABASE_URL and SUPABASE_ANON_KEY.
# Never expose the Supabase service-role key to the Android app or browser.
