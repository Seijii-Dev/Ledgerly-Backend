# Copy this to .env.local for local development.
# In Vercel, set these under Project Settings -> Environment Variables instead.

# Provided automatically if you use Vercel's Neon integration ("Storage" tab -> Add -> Neon).
# Otherwise, get this from your Neon/Postgres provider's dashboard.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Any long random string. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-long-random-secret
